# --- Gửi email OTP (quên mật khẩu) - tùy chọn ---
# Nếu để trống SMTP_HOST, mã OTP chỉ in ra console server và trả về trong response ở môi trường dev.
# Khi deploy production: BẮT BUỘC đặt NODE_ENV=production và cấu hình SMTP bên dưới.
# NODE_ENV=production
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=Memora <your_email@gmail.com>
