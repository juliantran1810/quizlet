# --- Gửi email OTP (quên mật khẩu & xác thực) ---
# Cách 1 (Khuyến nghị cho Render Free, Vercel, Railway): Dùng HTTP API qua cổng 443 HTTPS không bị chặn cổng
# - Resend (Khuyên dùng - 3,000 mail/tháng miễn phí): Đăng ký tại https://resend.com, lấy API key re_...
# RESEND_API_KEY=re_123456789
# RESEND_FROM=Memora <onboarding@resend.dev>
#
# - Hoặc SendGrid (100 mail/ngày miễn phí): Đăng ký tại https://sendgrid.com, lấy API key SG...
# SENDGRID_API_KEY=SG.123456789
# SENDGRID_FROM=your_verified_sender@gmail.com

# Cách 2 (Dùng cho máy local hoặc server trả phí): Dùng SMTP (Gmail App Password)
# Lưu ý: Render Free chặn các cổng SMTP 25, 465, 587. Nếu host trên Render Free nên dùng Cách 1.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=Memora <your_email@gmail.com>

# Tùy chọn: Đặt ALLOW_DEV_OTP=true nếu muốn hệ thống trả OTP ra màn hình (tiện cho test hoặc khi chưa cấu hình email)
# ALLOW_DEV_OTP=true
